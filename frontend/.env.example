# Copie para .env na pasta frontend/ e preencha após o deploy da API no Render.
# URL sem barra no final. Deve ser HTTPS em produção.
EXPO_PUBLIC_API_URL=https://quizify-api.onrender.com

# Opcional — só desenvolvimento local (dica via Gemini no cliente).
# Em produção deixe vazio; use POST /quiz/hint no backend.
# EXPO_PUBLIC_LLM_API_KEY=
