{
  "info": {
    "_postman_id": "b3c4d5e6-f7a8-9012-3456-7890abcdef12",
    "name": "Quizify API Automated QA",
    "description": "Collection de testes automatizados para a API do Quizify (Render). Inclui validações de contrato, lógica de negócio e tratamento de erros.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Status",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains online message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.contain(\"online\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Quiz Flow",
      "item": [
        {
          "name": "Start Quiz (OpenAI)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has attemptId and questions\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('attemptId');",
                  "    pm.expect(jsonData).to.have.property('questions');",
                  "    pm.expect(jsonData.questions).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Questions have required fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if(jsonData.questions.length > 0) {",
                  "        var q = jsonData.questions[0];",
                  "        pm.expect(q).to.have.property('id');",
                  "        pm.expect(q).to.have.property('prompt');",
                  "        pm.expect(q).to.have.property('options');",
                  "        pm.expect(q.options).to.have.lengthOf(4);",
                  "        pm.expect(q).to.have.property('correctIndex');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"count\": 12,\n    \"pattern\": [\"easy\", \"easy\", \"easy\", \"easy\", \"medium\", \"medium\", \"medium\", \"medium\", \"hard\", \"hard\", \"hard\", \"hard\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/quiz/start",
              "host": ["{{base_url}}"],
              "path": ["quiz", "start"]
            }
          }
        },
        {
          "name": "Get Hint (Invalid ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns empty hint for invalid ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.hint).to.eql(\"\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"questionId\": \"non-existent-id\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/quiz/hint",
              "host": ["{{base_url}}"],
              "path": ["quiz", "hint"]
            }
          }
        }
      ]
    },
    {
      "name": "Scoring Logic",
      "item": [
        {
          "name": "Calculate Score (Stop at Error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Score stops at first false\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    // [true (10), true (20), false (30), true (10)] -> deve dar 30",
                  "    pm.expect(jsonData.score).to.eql(30);",
                  "    pm.expect(jsonData.correct).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"answers\": [true, true, false, true],\n    \"points_per_question\": [10, 20, 30, 10]\n}"
            },
            "url": {
              "raw": "{{base_url}}/score",
              "host": ["{{base_url}}"],
              "path": ["score"]
            }
          }
        },
        {
          "name": "Calculate Score (All Correct)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Score sums all points\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.score).to.eql(60);",
                  "    pm.expect(jsonData.total_possible).to.eql(60);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"answers\": [true, true, true],\n    \"points_per_question\": [10, 20, 30]\n}"
            },
            "url": {
              "raw": "{{base_url}}/score",
              "host": ["{{base_url}}"],
              "path": ["score"]
            }
          }
        }
      ]
    },
    {
      "name": "Error Handling",
      "item": [
        {
          "name": "Score Mismatched Lengths",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"answers\": [true],\n    \"points_per_question\": [10, 20]\n}"
            },
            "url": {
              "raw": "{{base_url}}/score",
              "host": ["{{base_url}}"],
              "path": ["score"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://quizify-api-339f.onrender.com",
      "type": "string"
    }
  ]
}
